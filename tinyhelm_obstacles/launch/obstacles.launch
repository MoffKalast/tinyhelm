<launch>

	<arg name="helm_config" default="$(find tinyhelm_core)/param/helm.yaml"/>
	<arg name="planner_config" default="$(find tinyhelm_core)/param/planner_asv.yaml"/>
	<arg name="obstacles_config" default="$(find tinyhelm_core)/param/obstacles.yaml"/>

	<!-- The planner reads the usable corridor width off the active controller's params, hence planner_config -->
	<rosparam file="$(arg helm_config)" command="load"/>
	<rosparam file="$(arg planner_config)" command="load"/>
	<rosparam file="$(arg obstacles_config)" command="load"/>

	<node name="tinyhelm_scan_to_reliable_cloud" pkg="tinyhelm_obstacles" type="scan_to_cloud" output="screen"/>
	<node name="tinyhelm_scan_to_unreliable_cloud" pkg="tinyhelm_obstacles" type="scan_to_cloud" output="screen"/>

	<node name="tinyhelm_obstacles" pkg="tinyhelm_obstacles" type="obstacle_planner_node.py" output="screen"/>

</launch>
