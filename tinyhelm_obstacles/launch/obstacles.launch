<launch>

    <arg name="fixed_frame" default="world" />
    <arg name="cell_resolution" default="0.25"/>

    <!--<node name="tinyhelm_obstacles_node" pkg="tinyhelm_obstacles" type="sensor_to_obstacle_node.py" output="screen">
        <param name="fixed_frame" value="$(arg fixed_frame)"/>
        <param name="cell_resolution" value="$(arg cell_resolution)"/>
    </node>-->

	<node pkg="octomap_server" type="octomap_server_node" name="octomap_server">
		<param name="resolution" value="0.5" />
		<param name="frame_id" type="string" value="world" />

		<param name="sensor_model_max_range" value="25.0" />
        <param name="sensor_model_min_range" value="1.0" />

        <param name="sensor_model_hit" value="0.9" />
        <param name="sensor_model_miss" value="0.6" />

        <param name="pointcloud_min_z" value="-0.4" />
        <param name="pointcloud_max_z" value="1.0" />
        
        
		<remap from="cloud_in" to="/obstacle_cloud" />
	
	</node>

    <node name="tinyhelm_scan_to_cloud_node" pkg="tinyhelm_obstacles" type="scan_to_cloud" output="screen">
        <param name="fixed_frame" value="laser"/>
        <param name="scan_topic" value="/scan_filtered"/>
        <param name="cloud_topic" value="/obstacle_cloud"/>
    </node>

    <!--<node name="tinyhelm_obstacles_node" pkg="tinyhelm_obstacles" type="sensor_to_obstacle_xyz_node.py" output="screen">
        <param name="fixed_frame" value="$(arg fixed_frame)"/>
        <param name="cell_resolution" value="$(arg cell_resolution)"/>
    </node>-->

    <!--node name="tinyhelm_scan_to_grid_node" pkg="tinyhelm_obstacles" type="scan_to_grid" output="screen">
        <param name="fixed_frame" value="$(arg fixed_frame)"/>
        <param name="scan_topic" value="/scan_filtered"/>
        <param name="cell_resolution" value="$(arg cell_resolution)"/>
    </node>-->

</launch>
