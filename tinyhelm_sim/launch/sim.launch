<launch>
	<arg name="fixed_frame" default="local" />

	<node name="tinyhelm_world_sim_node" pkg="tinyhelm_sim" type="sim.py" output="screen">
		<param name="origin_lat" value="43.379296"/>
		<param name="origin_lon" value="16.602522"/>
		<param name="realtime_factor" value="1.0"/>
		<param name="rate" value="30"/>
	</node>

	<node name="tinyhelm_sim_obstacles_node" pkg="tinyhelm_sim" type="sim_obstacles.py" output="screen">
		<param name="fixed_frame" value="$(arg fixed_frame)"/>
		<param name="laser_frame" value="laser"/>
		<param name="scan_topic" value="/scan_filtered"/>
		<param name="max_range" value="50.0"/>
		<param name="num_beams" value="360"/>
		<param name="rate" value="10"/>
		<param name="noise_sigma" value="0.05"/>
		<param name="dropout_probability" value="0.02"/>
		<param name="speckle_rate" value="1.0"/>
		<rosparam param="polygons">[[[30.0, -10.0], [40.0, -10.0], [40.0, 10.0], [30.0, 10.0]]]</rosparam>
	</node>
</launch>
